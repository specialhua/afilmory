# 复制为 deploy/aliyun-static/.env 后填写。
# 该文件同时被 Node（process.loadEnvFile）和 bash（source）读取：
# 每行 KEY=value，值里不要有空格，不要写行尾注释。
#
# 注意：照片存储凭据、PHOTO_PROXY_BASE_URL 等 builder 需要的变量
# 仍然写在项目根目录的 .env 中，这里只放部署与 webhook 相关的配置。

# ---------- webhook 服务 ----------

# 只监听本机，由 nginx 等反向代理对外暴露
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=3002

# 必填，至少 24 个字符。生成：openssl rand -hex 32
# 会触发构建的 /oss、/build 要求携带（状态页和日志公开）；oss-event-forwarder 函数的 WEBHOOK_TOKEN 环境变量填同一个值
WEBHOOK_TOKEN=

# 收到照片变更后等待多少秒再构建（期间的新变更会合并为一次构建）
WEBHOOK_BUILD_DELAY_SECONDS=30

# 只处理该前缀下的对象，留空表示不限制
WEBHOOK_PHOTO_PREFIX=photos/

# 只处理这些 bucket 的事件（逗号分隔），留空表示不限制
WEBHOOK_ALLOWED_BUCKETS=

# 可选：日志文件路径，默认 deploy/aliyun-static/webhook/webhook.log
# WEBHOOK_LOG_FILE=

# ---------- 构建与发布 ----------

# 必填：静态站点所在的 OSS bucket，ossutil 路径格式
OSS_SITE_BUCKET=oss://your-site-bucket

# 构建各步骤的详细日志目录
BUILD_LOG_DIR=/tmp/afilmory-build-logs

# 构建完成后是否自动更新 photo-auth 函数（1 开启，0 关闭）
AUTO_DEPLOY_FC=1

# ---------- 阿里云函数计算 ----------

# aliyun CLI 的 profile 名（aliyun configure --profile <name>）
ALIYUN_PROFILE=default
ALIYUN_REGION=cn-hangzhou
FC_FUNCTION_NAME=afilmory-photo-auth
# ALIYUN_CLI_BIN=aliyun
